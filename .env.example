# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# OpenAI Configuration (for Concierge feature)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# OpenWeather API Configuration (for Weather features)
# Get a free API key from: https://openweathermap.org/api
NEXT_PUBLIC_OPENWEATHER_API_KEY=your-openweather-api-key-here

# Optional: Weather API Configuration (legacy)
NEXT_PUBLIC_WEATHER_API_KEY=your-weather-api-key-here
NEXT_PUBLIC_CABIN_LAT=40.6461
NEXT_PUBLIC_CABIN_LON=-111.4980
